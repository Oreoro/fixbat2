{
  "name": "fixbat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler d1 migrations apply fixbat --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply fixbat --local",
    "db:remote": "wrangler d1 migrations apply fixbat --remote",
    "typecheck": "tsc --noEmit",
    "css": "npx @tailwindcss/cli -i src/ui/tailwind.css -o src/ui/kumo.css --minify",
    "js": "esbuild src/ui/client.tsx --bundle --format=esm --platform=browser --jsx=automatic --minify --target=es2022 --outfile=src/ui/client-bundle.txt --log-level=error",
    "build": "npm run css && npm run js",
    "db:reset:local": "rm -rf .wrangler/state/v3/d1 && npm run db:local",
    "setup": "bash scripts/setup.sh",
    "test": "python3 test/audit.py && python3 test/users.py && python3 test/secrets.py && python3 test/onboarding.py && python3 test/trace.py && python3 test/pipeline.py && python3 test/languages.py && python3 test/providers.py && python3 test/api.py && python3 test/slack.py && python3 test/diagnosers.py && python3 test/commands.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0",
    "@cloudflare/kumo": "^2.12.0",
    "@phosphor-icons/react": "^2.1.10",
    "hono": "^4.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260828.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "wrangler": "^4.127.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260828.1": true
  }
}